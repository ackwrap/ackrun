#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10
EXTRA_COMMANDS="network_repair apply_settings"
EXTRA_HELP="\tnetwork_repair [--force]\tRestore DNS and network state; --force stops services and clears sing-box remnants\n\tapply_settings\tApply saved settings and verify the service state"

generate_token() {
	local token
	token="$(head -c 32 /dev/urandom | sha256sum | cut -c 1-48)"
	[ "${#token}" -eq 48 ] || return 1
	uci -q set ackwrap.main.api_token="$token"
	uci -q commit ackwrap
	echo "$token"
}

start_service() {
	local enabled port api_token data_dir logger timezone
	config_load ackwrap
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get port main port 8080
	case "$port" in
		''|*[!0-9]*)
			logger -t ackwrap "invalid listen port: expected 1-65535"
			return 1
			;;
	esac
	if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
		logger -t ackwrap "invalid listen port: expected 1-65535"
		return 1
	fi
	config_get api_token main api_token
	config_get data_dir main data_dir /etc/ackwrap
	config_get_bool logger main logger 1
	timezone="$(uci -q get system.@system[0].timezone)"
	[ -n "$api_token" ] || api_token="$(generate_token)"
	case "$api_token" in
		*[!A-Za-z0-9._~-]*)
			logger -t ackwrap "invalid API token: use only A-Z, a-z, 0-9, dot, underscore, tilde, or hyphen"
			return 1
			;;
	esac
	if [ "${#api_token}" -lt 16 ]; then
		logger -t ackwrap "invalid API token: expected at least 16 characters"
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/ackwrap
	procd_set_param env ACKWRAP_LISTEN_ADDR="0.0.0.0:$port"
	procd_append_param env ACKWRAP_API_TOKEN="$api_token"
	procd_append_param env ACKWRAP_DATA_DIR="$data_dir"
	procd_append_param env ACKWRAP_BINARY_DIR="$data_dir/bin"
	[ -n "$timezone" ] && procd_append_param env TZ="$timezone"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1048576 1048576"
	if [ "$logger" -eq 1 ]; then
		procd_set_param stdout 1
		procd_set_param stderr 1
	fi
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ackwrap
}

reload_service() {
	stop
	start
}

apply_settings() {
	local enabled attempts running
	config_load ackwrap
	config_get_bool enabled main enabled 1
	if ! reload_service >/dev/null 2>&1; then
		echo "ERROR"
		echo "应用失败：无法启动 Ackwrap，请检查端口、Token 和系统日志。"
		return 1
	fi
	attempts=0
	while [ "$attempts" -lt 10 ]; do
		running=0
		pidof /usr/bin/ackwrap >/dev/null 2>&1 && running=1
		if [ "$running" -eq "$enabled" ]; then
			echo "OK"
			if [ "$enabled" -eq 1 ]; then
				echo "设置已应用，Ackwrap 已启动。"
			else
				echo "设置已应用，Ackwrap 已停止。"
			fi
			return 0
		fi
		attempts=$((attempts + 1))
		sleep 1
	done
	echo "ERROR"
	echo "设置已保存，但 Ackwrap 未达到预期运行状态，请检查系统日志。"
	return 1
}

network_repair() {
	local data_dir status output message force_arg attempts
	force_arg=""
	case "$*" in
		"") ;;
		--force) force_arg="--force" ;;
		*)
			echo "ERROR"
			echo "用法：/etc/init.d/ackwrap network_repair [--force]"
			return 1
			;;
	esac
	if [ -n "$force_arg" ]; then
		stop >/dev/null 2>&1
		attempts=0
		# The init script is also named ackwrap; match only the daemon executable.
		while pidof /usr/bin/ackwrap >/dev/null 2>&1; do
			attempts=$((attempts + 1))
			if [ "$attempts" -ge 20 ]; then
				killall -KILL /usr/bin/ackwrap >/dev/null 2>&1
				break
			fi
			sleep 1
		done
	elif pidof sing-box >/dev/null 2>&1; then
		echo "ERROR"
		echo "网络修复失败：sing-box 核心正在运行，请先停止核心后再执行网络修复。"
		return 2
	fi
	config_load ackwrap
	config_get data_dir main data_dir /etc/ackwrap
	output="$(ACKWRAP_DATA_DIR="$data_dir" ACKWRAP_BINARY_DIR="$data_dir/bin" /usr/bin/ackwrap network-repair $force_arg 2>&1)"
	status=$?
	message="$(printf '%s\n' "$output" | tail -n 1)"
	case "$status" in
		0)
			logger -t ackwrap-network-repair "network repair completed"
			echo "OK"
			echo "${message:-网络修复完成：已检查并恢复 Ackwrap 接管的网络状态。}"
			;;
		2)
			logger -t ackwrap-network-repair "network repair rejected because sing-box is running"
			echo "ERROR"
			echo "网络修复失败：sing-box 核心正在运行，请先停止核心后再执行网络修复。"
			;;
		*)
			logger -t ackwrap-network-repair "network repair failed: $message"
			echo "ERROR"
			echo "${message:-网络修复失败，请检查系统日志。}"
			;;
	esac
	return "$status"
}
